# Sao chép file này thành .env.local rồi điền giá trị thật.
# KHÔNG BAO GIỜ commit .env.local hoặc giá trị thật vào git.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AI (Groq — từ điển, chat Alex, chấm bài) ────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Dịch (DeepL) ─────────────────────────────────────────────────────────
DEEPL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Gemini (dự phòng / tính năng khác) ──────────────────────────────────────
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Text-to-Speech (service account) ─────────────────────────────────
GOOGLE_TTS_CLIENT_EMAIL=xxxxx@xxxxx.iam.gserviceaccount.com
GOOGLE_TTS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"

# ── Cloudflare R2 (video upload) — xem docs/R2-SETUP.md ────────────────────
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=wordly-videos
# Tuỳ chọn — bỏ trống nếu chưa gắn domain public cho bucket
R2_PUBLIC_URL=

# ── Email (Resend + Gmail dự phòng) ─────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_USER=xxxxx@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ── Inngest (job nền) ────────────────────────────────────────────────────
INNGEST_EVENT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INNGEST_SIGNING_KEY=signkey-xxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Khác ─────────────────────────────────────────────────────────────────
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
