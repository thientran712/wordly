# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Monorepo: web app Next.js nằm trong web/, app native nằm trong mobile/.
# Các rule có dấu / ở đầu được neo vào gốc repo nên phải ghi rõ /web/...
# Các rule không có / (.env*, .DS_Store, .vercel...) áp dụng ở mọi cấp.

# dependencies
node_modules/
/web/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/web/coverage

# next.js
/web/.next/
/web/out/

# production
/web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ngoại lệ: file mẫu chỉ chứa placeholder, PHẢI được commit (quy tắc bảo
# mật ATLAS: checked-in .env.example với giá trị giả)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Artifact thiết kế lớn, không cần trong repo
/web/public/logo 3.7

# Môi trường test local (URL + key của Supabase local)
.env.test.local

# File tạm của Supabase CLI
supabase/.temp/

# Mobile — app iOS native (SwiftUI) ở mobile/ios/. .xcodeproj sinh từ project.yml (XcodeGen).
# Secrets.xcconfig chứa credential thật, KHÔNG BAO GIỜ commit.
mobile/ios/Config/Secrets.xcconfig
mobile/ios/*.xcodeproj
mobile/ios/build/
xcuserdata/
DerivedData/
