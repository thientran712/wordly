// Copy thành Secrets.xcconfig (đã gitignore) rồi điền giá trị thật.
// Trong xcconfig `//` là bắt đầu comment, nên URL phải viết https:/$()/host
WORDLY_WEB_BASE_URL = https:/$()/YOUR-APP.vercel.app
WORDLY_SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
WORDLY_SUPABASE_ANON_KEY = sb_publishable_REPLACE_ME
// Team ID Apple Developer — chỉ cần khi chạy trên máy thật
DEVELOPMENT_TEAM =
