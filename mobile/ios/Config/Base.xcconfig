// Cấu hình chung cho cả app và widget. Giá trị bí mật nằm ở Secrets.xcconfig.
// Quảng cáo AdMob: mặc định ID TEST của Google (không bao giờ tính tiền / vi
// phạm chính sách khi bấm thử). ID thật đặt trong Secrets.xcconfig, chỉ cho
// Release:  WORDLY_AD_UNIT_BANNER[config=Release] = ca-app-pub-…/…
// (Đặt TRƯỚC #include để Secrets.xcconfig ghi đè được.)
WORDLY_ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
WORDLY_AD_UNIT_APP_OPEN = ca-app-pub-3940256099942544/5575463023
WORDLY_AD_UNIT_BANNER = ca-app-pub-3940256099942544/2435281174
WORDLY_AD_UNIT_INTERSTITIAL = ca-app-pub-3940256099942544/4411468910
WORDLY_AD_UNIT_REWARDED = ca-app-pub-3940256099942544/1712485313

#include? "Secrets.xcconfig"

// Phải đăng ký trong team Apple Developer phát hành app (Identifiers → App IDs / App Groups)
WORDLY_BUNDLE_ID = com.thientran.wordly
WORDLY_APP_GROUP = group.com.thientran.wordly
